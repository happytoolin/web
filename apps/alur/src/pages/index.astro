---
export const prerender = true;

const commands = ["ni", "nr", "nlx", "nci", "node install"];
const installCommands = [
  { label: "macOS / Linux", command: "curl -fsSL https://bin.happytoolin.com/alur | sh" },
  { label: "PowerShell", command: "irm https://bin.happytoolin.com/alur.ps1 | iex" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="alur is a fast package-manager command router for npm, yarn, pnpm, bun, and deno." />
    <title>alur</title>
    <style>
      :root {
        background: oklch(18% 0.018 92);
        color: oklch(94% 0.018 86);
        font-family:
          Avenir Next,
          Avenir,
          Segoe UI,
          system-ui,
          sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        padding: clamp(24px, 6vw, 72px);
      }

      main {
        width: min(980px, 100%);
      }

      h1 {
        margin: 0;
        color: oklch(83% 0.14 78);
        font-size: clamp(84px, 18vw, 190px);
        line-height: 0.84;
        letter-spacing: 0;
      }

      p {
        max-width: 68ch;
        font-size: clamp(18px, 2vw, 25px);
        line-height: 1.5;
      }

      code {
        border-radius: 6px;
        padding: 3px 7px;
        background: oklch(26% 0.024 92);
        color: oklch(89% 0.12 78);
        font: inherit;
      }

      pre {
        overflow-x: auto;
        border: 1px solid oklch(44% 0.04 92);
        border-radius: 8px;
        margin: 26px 0;
        padding: 18px;
        background: oklch(14% 0.018 92);
      }

      pre code {
        padding: 0;
        background: transparent;
        font-family:
          SFMono-Regular,
          Menlo,
          Consolas,
          monospace;
        font-size: 15px;
      }

      .commands {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding: 0;
        margin: 34px 0;
        list-style: none;
      }

      .commands li {
        border: 1px solid oklch(44% 0.04 92);
        border-radius: 999px;
        padding: 10px 14px;
      }

      .installs {
        display: grid;
        gap: 18px;
        margin: 28px 0;
      }

      .install-label {
        margin: 0 0 8px;
        color: oklch(78% 0.045 86);
        font-size: 15px;
      }

      .installs pre {
        margin: 0;
      }

      a {
        color: oklch(83% 0.14 78);
        text-decoration-thickness: 0.08em;
        text-underline-offset: 0.18em;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>alur</h1>
      <p>
        Fast package-manager routing for <code>npm</code>, <code>yarn</code>,
        <code>pnpm</code>, <code>bun</code>, and <code>deno</code>.
      </p>
      <ul class="commands">
        {commands.map((command) => <li>{command}</li>)}
      </ul>
      <p>
        One native binary for fast script execution, short commands, and an optional Node shim.
      </p>
      <div class="installs">
        {
          installCommands.map((install) => (
            <div>
              <p class="install-label">{install.label}</p>
              <pre><code>{install.command}</code></pre>
            </div>
          ))
        }
      </div>
      <p>
        Published at <a href="https://alur.happytoolin.com">alur.happytoolin.com</a>. Install scripts live at
        <a href="https://bin.happytoolin.com/alur">bin.happytoolin.com/alur</a>.
      </p>
      <p>
        <a href="https://github.com/happytoolin/alur">GitHub</a>
      </p>
    </main>
  </body>
</html>

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "happytoolin-bin",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "bin.happytoolin.com",
      "custom_domain": true
    }
  ]
}

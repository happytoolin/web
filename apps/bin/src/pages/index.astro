---
export const prerender = true;

import { powershellInstallCommand, shellInstallCommand } from "../installers/alur";

const scripts = [
  { href: "/alur", label: "alur", platform: "macOS / Linux", command: shellInstallCommand },
  { href: "/alur.sh", label: "alur.sh", platform: "macOS / Linux alias", command: shellInstallCommand },
  { href: "/alur.ps1", label: "alur.ps1", platform: "PowerShell", command: powershellInstallCommand },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Install script host for Happy Tooling projects." />
    <title>Happy Tooling Bin</title>
    <style>
      :root {
        background: oklch(12% 0.02 250);
        color: oklch(92% 0.014 250);
        font-family:
          Avenir Next,
          Avenir,
          Segoe UI,
          system-ui,
          sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        padding: clamp(24px, 6vw, 72px);
      }

      main {
        width: min(880px, 100%);
      }

      h1 {
        max-width: 11ch;
        margin: 0;
        overflow-wrap: anywhere;
        font-size: clamp(48px, 9vw, 112px);
        line-height: 0.9;
        letter-spacing: 0;
      }

      p {
        max-width: 66ch;
        font-size: clamp(18px, 2vw, 24px);
        line-height: 1.5;
      }

      pre {
        overflow-x: auto;
        border: 1px solid oklch(34% 0.04 250);
        border-radius: 8px;
        margin: 12px 0 28px;
        padding: 18px;
        background: oklch(17% 0.024 250);
      }

      code {
        color: oklch(86% 0.12 159);
        font-family:
          SFMono-Regular,
          Menlo,
          Consolas,
          monospace;
        font-size: 15px;
      }

      ul {
        display: grid;
        gap: 18px;
        padding: 0;
        margin: 32px 0 0;
        list-style: none;
      }

      li {
        border-top: 1px solid oklch(34% 0.04 250);
        padding-top: 18px;
      }

      a {
        color: oklch(86% 0.12 159);
        text-decoration-thickness: 0.08em;
        text-underline-offset: 0.18em;
      }

      strong {
        display: block;
        margin-bottom: 4px;
        color: oklch(98% 0.01 250);
      }
    </style>
  </head>
  <body>
    <main>
      <h1>bin<wbr />.happytoolin<wbr />.com</h1>
      <p>
        Direct install scripts for Happy Tooling projects. Start with
        <a href="https://alur.happytoolin.com">alur.happytoolin.com</a>.
      </p>
      <ul>
        {
          scripts.map((script) => (
            <li>
              <strong>
                <a href={script.href}>{script.label}</a> <span>{script.platform}</span>
              </strong>
              <pre><code>{script.command}</code></pre>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>

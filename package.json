{
  "name": "@happytoolin/web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev:home": "pnpm --filter @happytoolin/home dev",
    "dev:alur": "pnpm --filter @happytoolin/alur-site dev",
    "dev:bin": "pnpm --filter @happytoolin/bin-site dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "preview:home": "pnpm --filter @happytoolin/home preview",
    "preview:alur": "pnpm --filter @happytoolin/alur-site preview",
    "preview:bin": "pnpm --filter @happytoolin/bin-site preview",
    "deploy:home": "pnpm --filter @happytoolin/home deploy",
    "deploy:alur": "pnpm --filter @happytoolin/alur-site deploy",
    "deploy:bin": "pnpm --filter @happytoolin/bin-site deploy",
    "deploy:dry-run": "pnpm -r --workspace-concurrency=1 --if-present deploy:dry-run",
    "cf:typegen": "pnpm -r --if-present cf:typegen"
  }
}
